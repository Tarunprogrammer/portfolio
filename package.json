{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs'); fs.copyFileSync('dist/index.html','dist/200.html'); fs.copyFileSync('dist/index.html','dist/404.html');\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:surge": "npx surge dist --domain eppetarun.surge.sh",
    "deploy:vercel": "npx vercel",
    "deploy:netlify": "npx netlify deploy --prod --dir=dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.5.5",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
